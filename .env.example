# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Stripe Configuration (Public)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here

# Application URLs
VITE_APP_URL=http://localhost:5173

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_AI_RECOMMENDATIONS=true

# ===== SERVER-SIDE ONLY (Edge Functions) =====
# These should NEVER be exposed to the frontend
# Add these to your Supabase Edge Function secrets:

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Email Service Configuration (if using external service)
# RESEND_API_KEY=your-resend-api-key
# OR
# SENDGRID_API_KEY=your-sendgrid-api-key

# ===== PRODUCTION NOTES =====
# 1. Never commit the .env file
# 2. Use different keys for development and production
# 3. Rotate keys regularly
# 4. Set up webhook endpoints in Stripe dashboard
# 5. Configure allowed origins in Supabase dashboard